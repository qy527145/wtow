# ---------------------------------------------------------------------------
# 本地开发默认值。这里只放【非敏感】配置，可以安全提交。
# 密钥 / 个人配置请写在 .env.local（已 gitignore，优先级更高），或由部署环境注入。
# 每个变量的说明见 .env.example，新增变量请同步更新那里和 apps/server/src/config.rs。
# ---------------------------------------------------------------------------

# 本地 Postgres，由 `bun run db:up` 启动（容器 wtow-pg，端口 55432）。
DATABASE_URL=postgres://wtow:wtow@127.0.0.1:55432/wtow

# 后端监听地址。容器内改为 0.0.0.0:8080。
WTOW_BIND=127.0.0.1:8080
WTOW_PUBLIC_BASE_URL=http://127.0.0.1:8080

# Vite 开发服务器端口（仅 dev 使用；/api 等代理到 WTOW_BIND）。
WEB_PORT=5173

WTOW_ATTACHMENT_DIR=./data/attachments
WTOW_RELEASE_DIR=./data/releases
WTOW_SUPERADMIN_EMAILS=

RUST_LOG=wtow_server=info,tower_http=info
