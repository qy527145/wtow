# 部署参数，复制成 deploy/.env 后按需修改。deploy/.env 已被 gitignore。
# 生产机密（数据库密码）不在这里，首次部署时在服务器上随机生成并保存在 <remote-dir>/.env。

# ssh 别名，需要能免密登录
WTOW_SSH_HOST=kt
WTOW_REMOTE_DIR=/opt/wtow

# 对外地址：写进 latest.json 和 install.sh，CLI 从这里下载。必须是别人能访问到的地址。
WTOW_PUBLIC_BASE_URL=http://47.97.189.132:8090

# 宿主机监听端口与 Postgres 端口（后者只绑 127.0.0.1）
WTOW_HOST_BIND=8090
WTOW_PG_PORT=15432
