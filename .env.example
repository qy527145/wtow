# 全部环境变量的说明。.env 提交默认值，.env.local 放本地覆盖与密钥。
# 服务端只在 apps/server/src/config.rs 读取这些变量。

# 必填。Postgres 连接串。
DATABASE_URL=postgres://wtow:wtow@127.0.0.1:55432/wtow

# 服务端监听地址，HOST:PORT。127.0.0.1 仅本机；容器内用 0.0.0.0:8080。
WTOW_BIND=127.0.0.1:8080

# 对外地址，写进安装脚本、下载页和 latest.json 的产物 URL。
WTOW_PUBLIC_BASE_URL=http://127.0.0.1:8080

# Vite 开发服务器端口。只在 `bun run dev` 时使用。
WEB_PORT=5173

# 附件存储目录。
WTOW_ATTACHMENT_DIR=./data/attachments

# CLI 发布产物与 latest.json 所在目录。
WTOW_RELEASE_DIR=./data/releases

# 逗号分隔的邮箱，注册或服务启动时自动成为超管（可看、可操作所有项目）。
WTOW_SUPERADMIN_EMAILS=

# tracing 过滤器，"<level>,<target>=<level>"。
RUST_LOG=wtow_server=info,tower_http=info

# 配置后 install.sh 强制校验 latest.json 的签名。
# WTOW_MINISIGN_PUBKEY=

# 仅 `bun run release` 使用：minisign 私钥路径，配置后给 latest.json 签名。
# WTOW_MINISIGN_SECRET_KEY=
