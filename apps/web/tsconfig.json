{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["vite/client", "bun"],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@/*": ["./src/*"],
      "@wtow/ui": ["../../packages/ui/src/index.ts"],
      "@wtow/ui/*": ["../../packages/ui/src/*"],
      "@wtow/shared": ["../../packages/shared/src/index.ts"]
